rules_version = '2';
// IQ Basics — Firebase Storage güvenlik kuralları
// Fotoğraflar isletme/iqbasics/foto/... altında tutulur.
// Okuma: giriş yapmış herkes (işletme kullanıcıları + portal müşterileri).
// Yazma: giriş yapmış kullanıcı, yalnızca resim (<= 5 MB).
service firebase.storage {
  match /b/{bucket}/o {
    match /isletme/iqbasics/{allPaths=**} {
      allow read: if request.auth != null;
      // Yazma: yalnız yönetici onayı almış kullanıcılar (rol yetkisi Firestore'da)
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*')
                   && firestore.get(/databases/(default)/documents/kullanicilar/$(request.auth.uid)).data.onay == true;
    }
    // diğer her şey kapalı
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
