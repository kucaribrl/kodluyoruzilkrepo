{
  "permissions": {
    "deny": [
      "mcp__github__create_repository",
      "mcp__github__fork_repository",
      "mcp__github__pull_request_review_write"
    ],
    "ask": [
      "mcp__github__issue_write",
      "mcp__github__sub_issue_write",
      "mcp__github__add_issue_comment",
      "mcp__github__update_issue_comment",
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__resolve_review_thread",
      "mcp__github__unresolve_review_thread",
      "mcp__github__request_copilot_review",
      "mcp__github__disable_pr_auto_merge"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guvenlik-kontrolu.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__github__create_or_update_file|mcp__github__push_files|mcp__github__delete_file|mcp__github__create_branch|mcp__github__merge_pull_request|mcp__github__enable_pr_auto_merge|mcp__github__update_pull_request_branch|mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__actions_run_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guvenlik-kontrolu.mjs"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
