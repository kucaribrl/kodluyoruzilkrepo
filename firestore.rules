rules_version = '2';
// IQ Basics — Firestore güvenlik kuralları (Faz 2: gerçek kullanıcı girişi)
// Firebase Console → Firestore Database → Rules → yapıştır → "Publish".
//
// ÖNEMLİ ilk kurulum (tek seferlik):
//  1) Authentication'da kendine bir hesap oluştur (e-posta+şifre) ve giriş yap.
//  2) Bu kuralları yayınla. Aşağıdaki sahipMi() e-posta listesinde olan hesap
//     otomatik yönetici olur — elle belge oluşturmana GEREK YOK.
//     (İstersen uygulamada Senkron Teşhis → "Bu Hesabı Yönetici Yap" ile
//      kullanicilar belgen de admin olarak yazılır; katalog yayını için gerekir.)
service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() { return request.auth != null; }
    // İŞLETME SAHİBİ — e-posta ile tanınır. Bu hesap(lar) kullanicilar belgesine
    // gerek olmadan her zaman yönetici sayılır (ilk kurulum kolaylığı).
    // Yeni ortak eklemek istersen e-postayı bu listeye ekle.
    function sahipMi() {
      return girisli() && request.auth.token.email in ['birol575@hotmail.com'];
    }
    function rolu() {
      return get(/databases/$(database)/documents/kullanicilar/$(request.auth.uid)).data.rol;
    }
    function adminMi() {
      return sahipMi() || (girisli()
        && exists(/databases/$(database)/documents/kullanicilar/$(request.auth.uid))
        && rolu() == 'admin');
    }

    // KULLANICILAR — kimlik + rol
    match /kullanicilar/{uid} {
      // Kendi profilini oku; yönetici herkesi okur
      allow read: if girisli() && (request.auth.uid == uid || adminMi());
      // Kendi kaydını oluşturur; onaysız + admin OLMADAN (kendini yönetici yapamaz).
      // İstisna: işletme sahibi (sahipMi) kendi belgesini admin olarak oluşturabilir.
      allow create: if (girisli()
        && request.auth.uid == uid
        && request.resource.data.onay == false
        && request.resource.data.rol in ['musteri','calisan','fason','magaza','depocu','ortak','fasontakip'])
        || (sahipMi() && request.auth.uid == uid);
      // Sahip kendi belgesini güncelleyebilir; onay / rol / silme yönetici (sahip dahil)
      allow update, delete: if adminMi() || (sahipMi() && request.auth.uid == uid);
    }

    // KATALOG — herkes okur, yalnız yönetici yazar
    match /magaza/{doc} {
      allow read: if true;
      allow write: if adminMi();
    }

    // SİPARİŞLER — giriş yapmış kullanıcı KENDİ adına oluşturur,
    // kendi siparişini okur; yönetici hepsini okur/günceller.
    match /siparisler/{id} {
      allow create: if girisli() && request.resource.data.uid == request.auth.uid;
      allow read:   if girisli() && (resource.data.uid == request.auth.uid || adminMi());
      allow update, delete: if adminMi();
    }

    // MÜŞTERİ ÖZEL VERİ (fiyat/bakiye/geçmiş) — yalnız o müşteri + yönetici (Faz 2b)
    match /musteri_veri/{uid} {
      allow read:  if girisli() && (request.auth.uid == uid || adminMi());
      allow write: if adminMi();
    }

    // FASON İŞ EMİRLERİ — yalnız o fason (okur+durum günceller) + yönetici (Faz 3)
    match /fason_isemri/{id} {
      allow read:   if girisli() && (resource.data.fasonUid == request.auth.uid || adminMi());
      allow update: if girisli() && (resource.data.fasonUid == request.auth.uid || adminMi());
      allow create, delete: if adminMi();
    }

    // CANLI ORTAK VERİ — gerçek zamanlı çok cihaz senkron, ALAN + ROL bazlı izin.
    // rolu(): kullanicilar/{uid}.rol  → admin | ortak | magaza | depocu
    function rolVar(liste){ return sahipMi() || (girisli()
      && exists(/databases/$(database)/documents/kullanicilar/$(request.auth.uid))
      && (rolu() in liste)); }
    match /isletme/{iid}/veri/stok   { allow read, write: if rolVar(['admin','ortak','magaza','depocu','fasontakip']); }
    match /isletme/{iid}/veri/cari   { allow read, write: if rolVar(['admin','ortak','magaza']); }
    match /isletme/{iid}/veri/satis  { allow read, write: if rolVar(['admin','ortak','magaza']); }
    match /isletme/{iid}/veri/kasa   { allow read, write: if rolVar(['admin','ortak']); }
    match /isletme/{iid}/veri/cek    { allow read, write: if rolVar(['admin','ortak']); }
    match /isletme/{iid}/veri/uretim { allow read, write: if rolVar(['admin','ortak','fasontakip']); }
    // ayar: tüm personel okur (firma/kur/ID sayacı); yazma yönetici+ortak (+ satış yapan mağaza — seq için)
    match /isletme/{iid}/veri/ayar   {
      allow read:  if rolVar(['admin','ortak','magaza','depocu','fasontakip']);
      allow write: if rolVar(['admin','ortak','magaza','fasontakip']);
    }
    // Diğer/yeni alanlar → yalnız yönetici+ortak
    match /isletme/{iid}/veri/{domen} { allow read, write: if rolVar(['admin','ortak']); }
  }
}
