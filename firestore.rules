rules_version = '2';
// Öz Tekstil — Firestore güvenlik kuralları
// Firebase Console → Firestore Database → Rules sekmesine yapıştır ve "Publish" de.
service cloud.firestore {
  match /databases/{database}/documents {

    // KATALOG: herkes okuyabilir (müşteri katalogu görür),
    // yalnızca giriş yapmış yönetici (sen) yazabilir.
    match /magaza/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // SİPARİŞLER: herkes yeni sipariş oluşturabilir (misafir sipariş),
    // yalnızca giriş yapmış yönetici okuyabilir/güncelleyebilir/silebilir.
    // (Böylece bir müşteri başka müşterinin siparişini göremez.)
    match /siparisler/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
